[Unit]
Description=Drakonix Vanilla Minecraft server (vanilla)
After=network.target

[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft/drakonixvanilla
# Inherited by the java process; backup.sh scans /proc/*/environ for this to
# tell "server down" from "RCON misconfigured while the server is actually up".
Environment=MC_SERVER_MARKER=drakonixvanilla
ExecStart=/srv/minecraft/drakonixvanilla/run.sh nogui
Restart=on-failure
RestartSec=10
# Vanilla saves the world and exits cleanly on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
