# Lets the `minecraft` service user stop/start its own systemd unit for cold
# nightly backups (scripts/backup.sh), without granting full sudo access.
#
# Install: sudo install -m 440 systemd/minecraft-backup-sudoers /etc/sudoers.d/minecraft-backup-drakonixvanilla
#          sudo visudo -c
#
# Filename on disk is suffixed with -drakonixvanilla so it doesn't collide
# with the sudoers drop-in installed by another server's repo on the same
# host (e.g. minecraft-backup-liminalindustries, minecraft-backup-drakonixtechpack).
minecraft ALL=(root) NOPASSWD: /usr/bin/systemctl stop minecraftserver-drakonixvanilla, /usr/bin/systemctl start minecraftserver-drakonixvanilla
